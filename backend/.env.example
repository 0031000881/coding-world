APP_NAME="Coding World"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=coding_world
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

# Coding World authenticates purely via Sanctum API (Bearer) tokens, not
# cookie-based SPA sessions, so SANCTUM_STATEFUL_DOMAINS/CSRF are not used.
# FRONTEND_URL is only needed for CORS (config/cors.php).
FRONTEND_URL=http://localhost:5173
